x="1" parent="1"><mxGeometry x="891.669" y="201" width="29.4449" height="34" as="geometry"/></mxCell><mxCell id="c110" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;direction=south;size=0.25;fixedSize=0;html=1;fillColor=none;strokeColor=#d62728;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="773.89" y="99" width="29.4449" height="34" as="geometry"/></mxCell><mxCell id="c111" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;direction=south;size=0.25;fixedSize=0;html=1;fillColor=none;strokeColor=#d62728;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="847.502" y="124.5" width="29.4449" height="34" as="geometry"/></mxCell><mxCell id="c112" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;direction=south;size=0.25;fixedSize=0;html=1;fillColor=none;strokeColor=#d62728;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="788.612" y="175.5" width="29.4449" height="34" as="geometry"/></mxCell><mxCell id="c113" value='&lt;font style="font-size:13px" color="#334155"&gt;colour: most common digit of a cell&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px" color="#334155"&gt;red outline: hotspot, where digits mix&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:13px" color="#334155"&gt;large QE = ‖&lt;i&gt;p&lt;/i&gt; − &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;i*&lt;/sub&gt;‖: novel input&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="689.68" y="249" width="286.64" height="56.7" as="geometry"/></mxCell><mxCell id="c114" value='&lt;font style="font-size:14px" color="#334155"&gt;&lt;b&gt;Training.&lt;/b&gt; Kohonen rule: &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt; ← &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt; + α (&lt;i&gt;p&lt;/i&gt; − &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;) for every neuron &lt;i&gt;i&lt;/i&gt; within distance &lt;i&gt;d&lt;/i&gt; of the winner on the grid.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#334155"&gt;The batch version used here (NNSOM, hexagonal grid) has no learning rate α: after each pass over the data,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#334155"&gt;every &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt; is set to a weighted average of the embeddings whose winner lies within &lt;i&gt;d&lt;/i&gt; hops of neuron &lt;i&gt;i&lt;/i&gt;.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#334155"&gt;The radius &lt;i&gt;d&lt;/i&gt; shrinks from 11 to 1 over the 250 epochs, so the map first orders itself and then fits the data.&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3f7ff;strokeColor=#365780;strokeWidth=1.6;fontFamily=Arial;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="335" width="960" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
