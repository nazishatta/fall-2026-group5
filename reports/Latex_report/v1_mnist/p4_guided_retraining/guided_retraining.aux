\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Test results, mean (standard deviation) over 5 seeds. Hotspot error is measured on the 146 test images that fall on hotspot neurons, non-hotspot error on the other 10,354. Both experiments use the same \texttt  {standard} arm.}}{4}{table.caption.2}\protected@file@percent }
\newlabel{tab:arms}{{1}{4}{Test results, mean (standard deviation) over 5 seeds. Hotspot error is measured on the 146 test images that fall on hotspot neurons, non-hotspot error on the other 10,354. Both experiments use the same \texttt {standard} arm}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The success criteria, fixed before the test split was used. Negative differences mean fewer errors for the first arm; 1 test hotspot image is about 0.7 points. Intervals: paired bootstrap over test images, mean of 5 seeds. The macro-F1 guard is the first arm's macro-F1 minus the second arm's; it may not fall below $-0.0016$.}}{5}{table.caption.3}\protected@file@percent }
\newlabel{tab:criteria}{{2}{5}{The success criteria, fixed before the test split was used. Negative differences mean fewer errors for the first arm; 1 test hotspot image is about 0.7 points. Intervals: paired bootstrap over test images, mean of 5 seeds. The macro-F1 guard is the first arm's macro-F1 minus the second arm's; it may not fall below $-0.0016$}{table.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces CF1 (standard) and CF2 (augmented\_som): mean test confusion matrices over 5 seeds, and their difference (blue: fewer cases, red: more).}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:cf_aug}{{2}{5}{CF1 (standard) and CF2 (augmented\_som): mean test confusion matrices over 5 seeds, and their difference (blue: fewer cases, red: more)}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces CF1 (standard) and CF2 (curriculum\_som), as in Figure~\ref {fig:cf_aug}.}}{5}{figure.caption.5}\protected@file@percent }
