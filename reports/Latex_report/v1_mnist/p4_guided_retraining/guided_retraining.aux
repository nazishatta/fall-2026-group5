\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Validation accuracy per epoch (mean of 5 seeds) for the curriculum arms (top) and the augmentation arms (bottom): all images, hotspot images, and images outside the hotspots.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:curves}{{4}{6}{Validation accuracy per epoch (mean of 5 seeds) for the curriculum arms (top) and the augmentation arms (bottom): all images, hotspot images, and images outside the hotspots}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Re-analysis: new SOMs after retraining}{6}{section.5}\protected@file@percent }
\newlabel{sec:reanalysis}{{5}{6}{Re-analysis: new SOMs after retraining}{section.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces SOM re-analysis on the validation split. Columns 2 to 5 are means over the 5 CNN seeds (the Phase 2 map is a single map). The last two columns are the paired difference per seed, averaged, with its 95\% $t$-interval (4 degrees of freedom); bold means the interval excludes 0. Linear CKA between the networks' embeddings: 0.931 within standard, 0.893 within augmented\_som, 0.917 within augmented\_random, 0.910 between arms.}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:reanalysis}{{3}{6}{SOM re-analysis on the validation split. Columns 2 to 5 are means over the 5 CNN seeds (the Phase 2 map is a single map). The last two columns are the paired difference per seed, averaged, with its 95\% $t$-interval (4 degrees of freedom); bold means the interval excludes 0. Linear CKA between the networks' embeddings: 0.931 within standard, 0.893 within augmented\_som, 0.917 within augmented\_random, 0.910 between arms}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Map measures per arm on validation images. Each dot is one CNN seed (grey lines join the same seed), the black bar is the mean over seeds, and the red dashed line is the Phase 2 map.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:reanalysis_measures}{{5}{7}{Map measures per arm on validation images. Each dot is one CNN seed (grey lines join the same seed), the black bar is the mean over seeds, and the red dashed line is the Phase 2 map}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Neuron purity on validation images for the Phase 2 map and the three arms (seed 1). Red squares mark the hotspot neurons of each map. The hotspots are picked again for every map.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:reanalysis_purity}{{6}{7}{Neuron purity on validation images for the Phase 2 map and the three arms (seed 1). Red squares mark the hotspot neurons of each map. The hotspots are picked again for every map}{figure.caption.9}{}}
