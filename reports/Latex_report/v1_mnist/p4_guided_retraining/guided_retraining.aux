\newlabel{sec:breakdown}{{6}{8}{Errors fixed, and error per digit (exploratory)}{section.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Test errors as counts (mean over the 5 seeds) and the net number of standard's errors each arm removed, per seed (seeds 1 to 5; positive means fewer errors than \texttt  {standard} with the same seed). Net fixed = errors of \texttt  {standard} that the arm gets right, minus new errors the arm makes. Exploratory, computed after the test pass from the saved predictions; all arms in the \texttt  {test\_errors\_fixed.csv} files of the two comparison folders under \texttt  {tables/}.}}{8}{table.caption.10}\protected@file@percent }
\newlabel{tab:errors_fixed}{{4}{8}{Test errors as counts (mean over the 5 seeds) and the net number of standard's errors each arm removed, per seed (seeds 1 to 5; positive means fewer errors than \texttt {standard} with the same seed). Net fixed = errors of \texttt {standard} that the arm gets right, minus new errors the arm makes. Exploratory, computed after the test pass from the saved predictions; all arms in the \texttt {test\_errors\_fixed.csv} files of the two comparison folders under \texttt {tables/}}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Test error (\%) per digit, mean over 5 seeds. Each digit has 947 to 1,181 test images, so 0.1 points is about one image. Exploratory; paired intervals for every comparison are in the \texttt  {test\_per\_class\_comparisons.csv} files of the two comparison folders under \texttt  {tables/}.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:per_class}{{5}{8}{Test error (\%) per digit, mean over 5 seeds. Each digit has 947 to 1,181 test images, so 0.1 points is about one image. Exploratory; paired intervals for every comparison are in the \texttt {test\_per\_class\_comparisons.csv} files of the two comparison folders under \texttt {tables/}}{table.caption.11}{}}
