# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ML Datasets (Regenerated via torchvision/scripts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/ood/*
!data/ood/.gitkeep

# Embeddings & Heavy Arrays (.npy, .pt, .h5)
data/embeddings/**/*.npy
data/embeddings/**/*.pt
data/embeddings/**/*.npz
data/embeddings/**/*.h5

# Model Checkpoints & Weights
*.pt
*.pth
*.ckpt
*.onnx
*.h5
checkpoints/

# Trained SOM objects & pickle files
*.som
*.pkl
*.joblib

# Logs & Tracking
runs/
wandb/
mlruns/
*.log

# LaTeX build byproducts (keep .tex and .bib, ignore compilation cache)
reports/paper/*.aux
reports/paper/*.bbl
reports/paper/*.blg
reports/paper/*.fdb_latexmk
reports/paper/*.fls
reports/paper/*.log
reports/paper/*.out
reports/paper/*.synctex.gz
reports/paper/*.toc

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# outputs/: generated results are not kept in git (project rule). Git keeps only
# small metrics and records (.json, .csv), DVC pointer files (.dvc), READMEs,
# .gitkeep files and the folders' own .gitignore files. Large data (checkpoints,
# embeddings, SOM models, logs) is tracked with DVC. Figures are regenerated by
# the pipeline. src/v1_mnist/tests/test_repository_rules.py checks that every
# tracked file under outputs/ is one of these types and small.
outputs/**
!outputs/**/
!outputs/**/*.json
!outputs/**/*.csv
!outputs/**/*.dvc
!outputs/**/README.md
!outputs/**/.gitkeep
!outputs/**/.gitignore

# Report figures are not kept in git either: copy them from outputs/ (see each
# report folder's README) before compiling. The GWU logo stays in git.
reports/Latex_report/**/fig/*.pdf
reports/Latex_report/**/figures/**/*.pdf
!reports/Latex_report/**/gwu_logo.pdf
